# ─── Correo SMTP (Gmail) ───────────────────────────────────────────────────────
# Usa una "Contraseña de aplicación" de Google, no tu contraseña normal.
# Cómo generarla: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_USER=tucorreo@gmail.com
GMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ─── Panel de administración ───────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_contraseña

# ─── URL pública del sitio (para los links en correos) ────────────────────────
NEXT_PUBLIC_SITE_URL=https://tudominio.com
